# Kinroot configuration. Copy to .env (make setup does this). Every value has a safe offline default.

# Django
DJANGO_ENV=dev
# Required when DJANGO_ENV=prod (50+ random characters)
SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
WEB_ORIGIN=http://localhost:3020
# SQLite by default; Postgres: postgres://user:pass@host:5432/kinroot (pip install -e "backend[postgres]")
DATABASE_URL=sqlite:///data/kinroot.db
LOG_LEVEL=INFO
LOG_JSON=false

# Sessions and limits
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
RATE_LIMIT_API=300/min
RATE_LIMIT_AUTH=10/min
RATE_LIMIT_ASSISTANT=20/min
MAX_UPLOAD_MB=10

# Graph (ADR 0001, 0002): ladybug | neo4j; writer: worker (API read-only) | inline (single process)
GRAPH_BACKEND=ladybug
GRAPH_WRITER=worker
GRAPH_MAX_DEPTH=10
UBO_THRESHOLD_PCT=25
# Optional Neo4j adapter (pip install -e "backend[neo4j]")
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Data sources (docs/DATA.md)
# bundled | opensanctions (after make data)
SANCTIONS_SOURCE=bundled
# UK and AU registries. Only the offline adapters exist today: COMPANIES_HOUSE_SOURCE=bundled (the bundled UK
# sample, or data/companies_house/ after make data) and ABN_SOURCE=mock (a synthetic AU registry). The other values
# (bulk / api, live) are reserved for adapters that are not implemented yet and are ignored.
COMPANIES_HOUSE_SOURCE=bundled
# Not used yet (reserved for a Companies House REST client)
COMPANIES_HOUSE_API_KEY=
ABN_SOURCE=mock
# Used only by scripts/fetch_abn.py to download raw ABN Lookup records into data/abn/
ABN_LOOKUP_GUID=

# Machine learning (MLflow: local SQLite + artifacts under the git-ignored mlruns/)
MLFLOW_DISABLE_AGENT_HINT=1

# Investigation assistant: deterministic offline answers unless LLM_FAKE=false and a key is set
LLM_FAKE=true
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODELS=gemini/gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Jobs, events, retention
JOBS_POLL_SECONDS=1.0
JOBS_LEASE_SECONDS=300
SSE_POLL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15
RETENTION_YEARS_DEFAULT=7
DATA_RESIDENCY=AU
